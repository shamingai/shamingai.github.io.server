{
  "name": "shamingai-blog-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "migrate": "node --no-warnings src/cli.js migrate",
    "start": "node --no-warnings src/cli.js serve",
    "dev": "node --no-warnings --watch src/cli.js serve",
    "generate": "node --no-warnings src/cli.js generate",
    "sync": "node --no-warnings src/cli.js sync",
    "test": "node --no-warnings --test tests/**/*.test.js",
    "coverage": "node --no-warnings --experimental-test-coverage --test --test-coverage-exclude='tests/**' tests/**/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6"
  }
}
