# 服务端口与监听地址
PORT=8787
HOST=127.0.0.1

# 数据库环境：test = 本地 MySQL，prod = 部署机连 116.62.78.39。
# 选择哪一套由 DB_PROFILE 决定，两套连接信息都写在下面，互不影响。
DB_PROFILE=test

# 本地测试库（DB_PROFILE=test）。真实账号密码放 .env.test，不要提交。
MYSQL_TEST_HOST=
MYSQL_TEST_PORT=3306
MYSQL_TEST_USER=
MYSQL_TEST_PASSWORD=
MYSQL_TEST_DATABASE=shamingai_blog

# 生产库（DB_PROFILE=prod）。真实账号密码放 .env.prod，只在部署机填写。
MYSQL_PROD_HOST=116.62.78.39
MYSQL_PROD_PORT=3306
MYSQL_PROD_USER=
MYSQL_PROD_PASSWORD=
MYSQL_PROD_DATABASE=prod

# 所选环境的 HOST 或 USER 留空时，回退到 SQLite 文件（离线试跑用）。
# 相对路径按进程工作目录解析，支持 ~/
DB_PATH=~/Library/Application Support/shamingai-blog/blog.db

# 本站仓库的检出目录（git clone 出来的 shamingai.github.io）。
# 资讯博客会写入 <SITE_REPO_DIR>/blog/content/posts/daily-YYYY-MM-DD.md，
# sync 命令会从这里导入文章。
SITE_REPO_DIR=~/jekyll/shamingai.github.io

# 管理接口令牌。留空则管理接口全部返回 503 admin_disabled。
# 生成：openssl rand -hex 32
API_TOKEN=

# 允许跨域访问的前端来源，逗号分隔；留空表示不启用 CORS。
# 不配置时只放行正式前端 https://blog.zhaotong.fun；
# 本地开发需要直连后端时追加，例如 https://blog.zhaotong.fun,http://localhost:5173
CORS_ORIGINS=https://blog.zhaotong.fun

# OpenAI 兼容接口（DeepSeek、通义、Kimi、vLLM 等均可）。
# LLM_BASE_URL 不带 /chat/completions，客户端会自己拼。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=120000

# 每日定时生成。SCHEDULER=off 关闭；时间为 SCHEDULE_TIME_ZONE 时区。
SCHEDULER=on
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
SCHEDULE_TIME_ZONE=Asia/Shanghai

# 日志：info / debug / off
LOG_LEVEL=info

# 每篇资讯收录条数
DIGEST_SIZE=10

# 采集热榜
COLLECT_CONCURRENCY=3
COLLECT_RETRIES=1
COLLECT_TIMEOUT_MS=15000

# 原文链接可达性检查
LINK_CHECK_TIMEOUT_MS=8000
